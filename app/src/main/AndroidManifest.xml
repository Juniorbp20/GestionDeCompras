<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <package android:name="com.google.android.gm" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="Gestión de Compras"
        android:icon="@mipmap/ic_shoppong"
        android:roundIcon="@mipmap/ic_shoppong"
        android:supportsRtl="true"
        android:theme="@style/Theme.GestionDeCompras">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>


        <activity android:name="com.example.gestiondecompras.activities.TiendasActivity"
            android:label="@string/tiendas_titulo"
            android:parentActivityName=".activities.MasActivity" />
        <activity android:name="com.example.gestiondecompras.activities.TarjetasActivity"
            android:label="@string/tarjetas_title"
            android:parentActivityName=".activities.MainActivity" />
        <activity android:name="com.example.gestiondecompras.activities.ListaPedidosActivity"
            android:label="@string/pedidos_title"
            android:parentActivityName=".activities.MainActivity" />
        <activity android:name="com.example.gestiondecompras.activities.NuevoPedidoActivity"
            android:label="@string/nuevo_pedido"
            android:parentActivityName=".activities.MainActivity" />
        <activity android:name="com.example.gestiondecompras.activities.ListaClientesActivity"
            android:label="@string/clientes_title"
            android:parentActivityName=".activities.MainActivity" />
        <activity android:name="com.example.gestiondecompras.activities.ReportesActivity"
            android:label="@string/reportes_title"
            android:parentActivityName=".activities.MainActivity" />
        <activity android:name="com.example.gestiondecompras.activities.NuevoClienteActivity"
            android:label="@string/nuevo_cliente_title"
            android:parentActivityName=".activities.ListaClientesActivity" />
        <activity android:name="com.example.gestiondecompras.activities.NuevaTarjetaActivity"
            android:label="@string/tarjetas_nueva"
            android:parentActivityName=".activities.TarjetasActivity" />
        <activity android:name="com.example.gestiondecompras.activities.CalendarioActivity"
            android:label="@string/calendario"
            android:parentActivityName=".activities.MainActivity" />
        <activity android:name="com.example.gestiondecompras.activities.SettingsActivity"
            android:label="@string/configuracion"
            android:parentActivityName=".activities.MainActivity" />
        <activity android:name="com.example.gestiondecompras.activities.FinanzasActivity"
            android:label="@string/fin_title"
            android:parentActivityName=".activities.MainActivity" />
        <activity android:name="com.example.gestiondecompras.activities.NuevoMovimientoActivity"
            android:label="@string/fin_nuevo_movimiento"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".activities.FinanzasActivity" />
        <activity android:name="com.example.gestiondecompras.activities.CategoriasFinActivity"
            android:label="@string/fin_categorias"
            android:parentActivityName=".activities.FinanzasActivity" />
        <activity android:name="com.example.gestiondecompras.activities.CuentasActivity"
            android:label="@string/fin_cuentas"
            android:parentActivityName=".activities.FinanzasActivity" />
        <activity android:name="com.example.gestiondecompras.activities.PresupuestosActivity"
            android:label="@string/fin_presupuestos"
            android:parentActivityName=".activities.FinanzasActivity" />
        <activity android:name="com.example.gestiondecompras.activities.RecurrentesActivity"
            android:label="@string/fin_recurrentes"
            android:parentActivityName=".activities.FinanzasActivity" />
        <activity android:name="com.example.gestiondecompras.activities.BusquedaActivity"
            android:label="@string/busqueda_title"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:parentActivityName=".activities.MainActivity" />
        <activity android:name="com.example.gestiondecompras.activities.MasActivity"
            android:label="@string/mas_title"
            android:parentActivityName=".activities.MainActivity" />
        <activity android:name="com.example.gestiondecompras.activities.TutorialActivity"
            android:label="@string/tutorial_ver" />
        <activity android:name="com.example.gestiondecompras.activities.AyudaActivity"
            android:label="@string/ayuda_title"
            android:parentActivityName=".activities.MainActivity" />


        <activity android:name="com.example.gestiondecompras.activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
