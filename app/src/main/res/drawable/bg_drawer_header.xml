<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/hero_gradient_start"
                android:endColor="@color/hero_gradient_end" />
        </shape>
    </item>
    <!-- Línea dorada inferior -->
    <item android:gravity="bottom" android:height="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_300" />
        </shape>
    </item>
</layer-list>
