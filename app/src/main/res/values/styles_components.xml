<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===================== Formas ===================== -->
    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.App.ExtraLarge" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.App.Full" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ===================== Tarjetas ===================== -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/background_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Tarjeta con degradado marino (hero / tarjeta de crédito) -->
    <style name="Widget.App.CardView.Hero" parent="Widget.App.CardView">
        <item name="cardBackgroundColor">@color/hero_gradient_start</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">24dp</item>
    </style>

    <!-- Tile de acción rápida -->
    <style name="Widget.App.CardView.Tile" parent="Widget.App.CardView">
        <item name="cardCornerRadius">18dp</item>
    </style>

    <!-- ===================== Botones ===================== -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.LabelLarge</item>
        <item name="android:textSize">15sp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Full</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.LabelLarge</item>
        <item name="android:textSize">15sp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Full</item>
        <item name="strokeColor">@color/colorOutline</item>
    </style>

    <!-- Botón dorado para acciones destacadas -->
    <style name="Widget.App.Button.Gold" parent="Widget.App.Button">
        <item name="backgroundTint">@color/accent_gold</item>
        <item name="android:textColor">@color/on_accent_gold</item>
        <item name="iconTint">@color/on_accent_gold</item>
    </style>

    <!-- ===================== Campos de texto ===================== -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>
    </style>

    <style name="Widget.App.TextInputLayout.Dense" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>
    </style>

    <style name="Widget.App.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>
    </style>

    <!-- ===================== Chips ===================== -->
    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="android:textAppearance">@style/TextAppearance.App.LabelLarge</item>
        <item name="chipCornerRadius">50dp</item>
    </style>

    <!-- ===================== FAB ===================== -->
    <style name="Widget.App.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/accent_gold</item>
        <item name="tint">@color/on_accent_gold</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Large</item>
    </style>

    <!-- ===================== Toolbar ===================== -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.ToolbarTitleDark</item>
        <item name="titleCentered">true</item>
    </style>

    <!-- ===================== Barra inferior ===================== -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/background_card</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavigationView.Indicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.LabelMedium</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.LabelMedium</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.App.BottomNavigationView.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_gold_container</item>
    </style>

    <!-- ===================== Hoja de acciones ===================== -->
    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
    </style>

    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/background_card</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SheetTop</item>
    </style>

    <style name="ShapeAppearance.App.SheetTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ===================== Diálogos ===================== -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.ExtraLarge</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.App.Title</item>
    </style>

    <style name="ThemeOverlay.App.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <style name="MaterialAlertDialog.App.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.App.TitleLarge</item>
    </style>
</resources>
