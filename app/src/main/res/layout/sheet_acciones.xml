<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja inferior de acciones de un elemento (ver utils/HojaAcciones) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- Asa de arrastre -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_accent_bar"
        android:backgroundTint="@color/gray_light" />

    <TextView
        android:id="@+id/tvHojaTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="24dp"
        android:textAppearance="@style/TextAppearance.App.TitleLarge"
        android:textColor="@color/gray_dark"
        tools:text="Ana Pérez" />

    <TextView
        android:id="@+id/tvHojaSubtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFeatureSettings="tnum"
        android:paddingHorizontal="24dp"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textColor="@color/gray"
        tools:text="Shein · RD$ 1,200.00" />

    <LinearLayout
        android:id="@+id/layoutHojaAcciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <View
        android:id="@+id/separadorHojaPeligro"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="6dp"
        android:background="@color/card_stroke" />

    <LinearLayout
        android:id="@+id/layoutHojaPeligro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
