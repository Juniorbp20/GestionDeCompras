<?xml version="1.0" encoding="utf-8"?>
<!-- Finanzas > Movimientos: búsqueda, filtros y lista agrupada por día -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.App.TextInputLayout.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/fin_buscar_hint"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltros"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/fin_filtros"
            app:icon="@drawable/ic_filter"
            app:iconTint="@color/gray_dark" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/grupoTipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTodos"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/fin_filtro_todos" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipIngresos"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fin_ingresos" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipGastos"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fin_gastos" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tvResumenFiltro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/gray"
            tools:text="12 movimientos · Ingresos RD$ 30,000 · Gastos RD$ 12,400" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimpiar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="@string/fin_limpiar"
            android:textColor="@color/accent_gold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMovimientos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            tools:listitem="@layout/item_movimiento" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wallet"
                app:tint="@color/gray_light" />

            <TextView
                android:id="@+id/tvVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/fin_sin_movimientos"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                android:textColor="@color/gray" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVacioAccion"
                style="@style/Widget.App.Button.Gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="24dp"
                android:text="@string/fin_crear_movimiento"
                app:icon="@drawable/ic_add_circle"
                app:iconGravity="textStart" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
