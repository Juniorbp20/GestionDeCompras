<?xml version="1.0" encoding="utf-8"?>
<!-- Pago de una tarjeta: tarjeta y deuda destacadas, monto con "toda la deuda" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvTarjetaNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.App.Overline"
        tools:text="Banco Popular - Visa" />

    <TextView
        android:id="@+id/tvDeudaActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_bold"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/error_color"
        android:textSize="20sp"
        tools:text="Deuda actual: RD$ 12,500.00" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilMontoPagoTarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/pago_tarjeta_monto"
        app:prefixText="RD$ ">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMontoPagoTarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:inputType="numberDecimal"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPagarTodaDeuda"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:minHeight="36dp"
        android:text="@string/pago_tarjeta_toda_deuda" />
</LinearLayout>
