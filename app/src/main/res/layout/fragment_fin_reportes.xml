<?xml version="1.0" encoding="utf-8"?>
<!-- Finanzas > Reportes: análisis de un rango de fechas y exportación -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollReportes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoRango"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEsteMes"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/fin_rep_este_mes" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMesAnterior"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fin_rep_mes_anterior" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTrimestre"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fin_rep_trimestre" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAnio"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fin_rep_anio" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPersonalizado"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fin_rep_personalizado" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvRango"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/gray"
            tools:text="01 nov 2026 – 30 nov 2026" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.CardView.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_navy"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fin_ingresos"
                            android:textAppearance="@style/TextAppearance.App.Overline"
                            android:textColor="@color/hero_text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvRepIngresos"
                            android:layout_width="match_parent"
                            android:layout_height="22dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="@font/inter_bold"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textColor="@color/hero_text"
                            app:autoSizeMaxTextSize="16sp"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fin_gastos"
                            android:textAppearance="@style/TextAppearance.App.Overline"
                            android:textColor="@color/hero_text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvRepGastos"
                            android:layout_width="match_parent"
                            android:layout_height="22dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="@font/inter_bold"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textColor="@color/hero_text"
                            app:autoSizeMaxTextSize="16sp"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fin_rep_balance"
                            android:textAppearance="@style/TextAppearance.App.Overline"
                            android:textColor="@color/hero_text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvRepBalance"
                            android:layout_width="match_parent"
                            android:layout_height="22dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="@font/inter_bold"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textColor="@color/hero_text"
                            app:autoSizeMaxTextSize="16sp"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvRepDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                    android:textColor="@color/hero_text_secondary"
                    tools:text="24 movimientos · Ahorro 32%" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportarPdf"
                style="@style/Widget.App.Button.Gold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/fin_rep_pdf"
                app:icon="@drawable/ic_export"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportarCsv"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/fin_rep_csv"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLayoutGastosCat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTituloGastosCat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fin_gastos_por_categoria"
                    android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                <LinearLayout
                    android:id="@+id/layoutGastosCat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLayoutIngresosCat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTituloIngresosCat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fin_ingresos_por_categoria"
                    android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                <LinearLayout
                    android:id="@+id/layoutIngresosCat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLayoutCuentasRep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTituloCuentasRep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fin_rep_por_cuenta"
                    android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                <LinearLayout
                    android:id="@+id/layoutCuentasRep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLayoutMeses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTituloMeses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fin_rep_por_mes"
                    android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                <LinearLayout
                    android:id="@+id/layoutMeses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLayoutMayores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTituloMayores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fin_rep_mayores_gastos"
                    android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                <LinearLayout
                    android:id="@+id/layoutMayores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvRepVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/fin_sin_datos_periodo"
            android:textAppearance="@style/TextAppearance.App.BodyMedium"
            android:textColor="@color/gray"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
