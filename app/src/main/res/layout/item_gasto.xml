<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivIcono"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_square"
            android:backgroundTint="@color/dashboard_badge_red_bg"
            android:padding="9dp"
            android:src="@drawable/ic_wallet"
            android:tint="@color/error_color" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.TitleSmall"
                android:textColor="@color/gray_dark"
                tools:text="Mercado" />

            <TextView
                android:id="@+id/tvCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/gray"
                tools:text="Comida - 08/08/2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMonto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_bold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/error_color"
            android:textSize="15sp"
            tools:text="RD$ 1,200.00" />

        <ImageButton
            android:id="@+id/btnMas"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/acciones_mas_opciones"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/gray" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
