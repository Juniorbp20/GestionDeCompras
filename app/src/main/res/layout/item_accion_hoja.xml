<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp">

    <ImageView
        android:id="@+id/ivAccionIcono"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_square"
        android:backgroundTint="@color/colorPrimaryContainer"
        android:contentDescription="@null"
        android:padding="8dp"
        android:tint="@color/primary_color"
        tools:src="@drawable/ic_edit" />

    <TextView
        android:id="@+id/tvAccionTexto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.App.BodyLarge"
        android:textColor="@color/gray_dark"
        tools:text="Editar" />
</LinearLayout>
