<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de tabla de reportes: nombre | columna 2 | columna 3 | columna 4 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tvCol1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textColor="@color/gray_dark"
        tools:text="Comida" />

    <TextView
        android:id="@+id/tvCol2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.7"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:textColor="@color/gray"
        tools:text="42%" />

    <TextView
        android:id="@+id/tvCol3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:textColor="@color/gray"
        tools:text="RD$ 1,200" />

    <TextView
        android:id="@+id/tvCol4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:fontFamily="@font/inter_semibold"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/gray_dark"
        android:textSize="13sp"
        tools:text="RD$ 4,200.00" />
</LinearLayout>
