<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/ivIcono"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_square"
        android:importantForAccessibility="no"
        android:padding="9dp"
        tools:src="@drawable/ic_restaurant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.TitleSmall"
            android:textColor="@color/gray_dark"
            tools:text="Comida" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/gray"
            android:visibility="gone"
            tools:text="12 movimientos"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/pbProgreso"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_presupuesto"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/inter_semibold"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/gray_dark"
        android:textSize="14sp"
        tools:text="RD$ 5,000.00" />

    <ImageButton
        android:id="@+id/btnMas"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/acciones_mas_opciones"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/gray" />
</LinearLayout>
