<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivIcono"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_square"
            android:importantForAccessibility="no"
            android:padding="7dp"
            tools:src="@drawable/ic_restaurant" />

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.TitleSmall"
            android:textColor="@color/gray_dark"
            tools:text="Comida" />

        <TextView
            android:id="@+id/tvDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/gray"
            tools:text="RD$ 800 de RD$ 1,000 (80%)" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbProgreso"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_presupuesto" />
</LinearLayout>
