<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <View
        android:id="@+id/vPunto"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_dot"
        android:backgroundTint="@color/category_other" />

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textColor="@color/gray_dark"
        tools:text="Comida" />

    <TextView
        android:id="@+id/tvPorcentaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:textColor="@color/gray"
        tools:text="42%" />

    <TextView
        android:id="@+id/tvMonto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/gray_dark"
        android:textSize="14sp"
        tools:text="RD$ 4,200.00" />
</LinearLayout>
