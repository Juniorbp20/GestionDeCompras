<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:title="@string/reportes_title"
        app:titleCentered="true"
        app:titleTextAppearance="@style/TextAppearance.ToolbarTitleDark"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/gray_dark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false">

            <!-- CARD FILTROS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reportes_filter_title"
                        android:textAppearance="@style/TextAppearance.App.Overline" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.App.TextInputLayout.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/reportes_search_hint"
                        app:startIconDrawable="@drawable/ic_search">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBuscarCliente"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            tools:text="Ana" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/btnFechaDesde"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="@string/reportes_fecha_desde"
                            app:endIconDrawable="@drawable/ic_calendar"
                            app:endIconMode="custom">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFechaDesde"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/btnFechaHasta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="@string/reportes_fecha_hasta"
                            app:endIconDrawable="@drawable/ic_calendar"
                            app:endIconMode="custom">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFechaHasta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RESUMEN: total de ventas destacado sobre degradado marino -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIngresos"
                style="@style/Widget.App.CardView.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_navy"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reportes_total_ventas"
                        android:textAppearance="@style/TextAppearance.App.Overline"
                        android:textColor="@color/hero_text_secondary" />

                    <TextView
                        android:id="@+id/tvTotalVentas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.App.DisplaySmall"
                        android:textColor="@color/hero_text"
                        tools:text="RD$ 18,900.00" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_gold_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/reportes_total_cobrado"
                                android:textAppearance="@style/TextAppearance.App.Overline"
                                android:textColor="@color/hero_text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTotalCobrado"
                                android:layout_width="match_parent"
                                android:layout_height="22dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="6dp"
                                android:fontFamily="@font/inter_bold"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                app:autoSizeMaxTextSize="15sp"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeTextType="uniform"
                                android:textColor="@color/hero_positive"
                                tools:text="RD$ 12,500.00" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/reportes_total_pendiente"
                                android:textAppearance="@style/TextAppearance.App.Overline"
                                android:textColor="@color/hero_text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTotalPendiente"
                                android:layout_width="match_parent"
                                android:layout_height="22dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="6dp"
                                android:fontFamily="@font/inter_bold"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                app:autoSizeMaxTextSize="15sp"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeTextType="uniform"
                                android:textColor="@color/gold_300"
                                tools:text="RD$ 8,300.00" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/reportes_total_ganancia"
                                android:textAppearance="@style/TextAppearance.App.Overline"
                                android:textColor="@color/hero_text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTotalGanancia"
                                android:layout_width="match_parent"
                                android:layout_height="22dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="6dp"
                                android:fontFamily="@font/inter_bold"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                app:autoSizeMaxTextSize="15sp"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeTextType="uniform"
                                android:textColor="@color/hero_text"
                                tools:text="RD$ 9,100.00" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvSeccionPedidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/reportes_por_pagar_title"
                android:textAppearance="@style/TextAppearance.App.SectionTitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReportePedidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_pedido" />

            <TextView
                android:id="@+id/tvPorPagarVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/reportes_por_pagar_vacios"
                android:textColor="@color/gray"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPagadosTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/reportes_pagados_title"
                android:textAppearance="@style/TextAppearance.App.SectionTitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPagados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_pedido" />

            <TextView
                android:id="@+id/tvPagadosVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/reportes_pagados_vacios"
                android:textColor="@color/gray"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportPagados"
                android:layout_width="match_parent"
                style="@style/Widget.App.Button.Gold"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:text="@string/reportes_export_pdf"
                app:icon="@drawable/ic_export"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportCsv"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/exportar_csv"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart" />
        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>